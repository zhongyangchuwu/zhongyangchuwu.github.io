---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Rclone Personal Drive Access">
  <div class="container-narrow">
    <header class="page-header">
      <h1 class="page-title">Rclone Personal Drive Access</h1>
      <p class="page-subtitle">Personal OAuth application information</p>
    </header>

    <div class="prose">
      <p>
        This application is used solely by the site owner to access and manage
        the owner's own Google Drive through rclone.
      </p>

      <p>
        It is not offered as a public service. Access is granted only after the
        Google account owner explicitly authorizes the application.
      </p>

      <p>
        Google Drive data is processed locally through rclone. This application
        does not sell user data or share it with third parties.
      </p>

      <p>
        <a href="/apps/rclone/privacy/">Privacy Policy</a>
      </p>
    </div>
  </div>
</BaseLayout>
